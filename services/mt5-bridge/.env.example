# Run this service on the same Windows machine as the MT5 terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
BRIDGE_API_TOKEN=replace-with-a-long-random-secret
DATABASE_URL=postgresql://trader:change-me@localhost:5432/trader
TRADING_MODE=demo
ALLOW_LIVE_TRADING=false
LIVE_CONFIRMATION=
MAX_RISK_PER_TRADE_PCT=0.25
MAX_DAILY_LOSS_PCT=1.0
MAX_ORDERS_PER_DAY=5
MAX_LOTS=0.10
MAX_OPEN_POSITIONS=3
MAX_SPREAD_POINTS=1000
ALLOWED_SYMBOLS=XAUUSD,USDJPY
REQUIRE_NEWS_PROVIDER=true
NEWS_BLACKOUT_MINUTES=30
KILL_SWITCH=true
CORS_ORIGINS=http://localhost:5173

FINNHUB_API_KEY=
